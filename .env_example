# ═══ 基本配置 ═══
APP_NAME=interactive-bot
BOT_TOKEN=replace_with_botfather_token
BOT_USERNAME=your_bot_username

# ═══ 管理配置 ═══
ADMIN_GROUP_ID=-1001234567890
ADMIN_USER_IDS=123456789,987654321

# ═══ 默认 LLM 配置 ═══
# 支持 OpenAI / DeepSeek / Ollama / 任何 OpenAI 兼容 API
# 这些值会作为机器人后台「AI 设置」的初始默认配置。
# 启动后可在 Telegram 机器人内新增多个 AI、选择首位模型；首位失败会自动切换备用 AI。
# Ollama 本地: http://localhost:11434/v1
# DeepSeek:    https://api.deepseek.com/v1
# OpenAI:      https://api.openai.com/v1
# 第三方中转:   https://your-proxy.com/v1
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-flash

# ═══ 风控配置 ═══
BLACKLIST_USER_IDS=
RATE_LIMIT_PER_MINUTE=10
MESSAGE_INTERVAL=5
DISABLE_CAPTCHA=FALSE

# ═══ 功能开关 ═══
DELETE_TOPIC_AS_FOREVER_BAN=FALSE
DELETE_USER_MESSAGE_ON_CLEAR_CMD=TRUE
WELCOME_MESSAGE="欢迎！我是 AI 客服助手，很高兴为您服务。

如需人工客服，点击下方按钮即可呼叫。"

# ═══ 界面 ═══
# 卡片与按钮使用 tgiosicons 自定义表情（需 Bot 所有者有 Telegram Premium）；FALSE 则使用普通 emoji
CUSTOM_EMOJI=TRUE

# 前台预检 V1
FRONTDESK_ENABLED=TRUE

# ═══ 收款(可选)═══
# GMPay v2(EPUSDT)网关:务必在网关后台为本机器人新建专用商户,先 1–2 USDT 小额实测。
GMPAY_BASE=https://your-gmpay-gateway.example
GMPAY_PID=
GMPAY_SECRET=
# TON 收款地址:默认为空,仓库不内置任何地址(也可在 /cfg 配置中心由业主发布)
TON_ADDRESS=
