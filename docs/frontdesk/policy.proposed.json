  "intent": {
    "labels": [
      "business_relevant",
      "exploring",
      "off_topic",
      "explicitly_no_business",
      "uncertain"
    ],
    "warn_on_first_off_topic": true,
    "further_consecutive_off_topic_messages_before_handoff": 2,
    "uncertain_messages_before_clarification_handoff": 2,
    "uncertain_increments_off_topic": false,
    "explicitly_no_business_handoff": true,
    "support_uses_sales_intent_gate": false,
    "never_treat_as_no_intent_alone": [
      "unknown_budget",
      "price_objection",
      "comparison",
      "browsing",
      "asks_if_ai",
      "requests_examples"
    ]
  },
  "handoff": {
    "cancel_pending_generation": true,
    "check_state_before_every_send": true,
    "persist_before_notify": true,
    "old_callbacks_can_resume_ai": false,
    "admin_lock_requires_admin_release": true,
    "low_intent_recheck_cooldown_hours": 24,
    "recheck_resets_usage": false,
    "idle_after_minutes": 30,
    "idle_resets_usage": false,
    "automatic_idle_followup": false
  },
  "knowledge": {
    "allowed_domains": [
      "tg.web3baimao.com",
      "web3baimao.com",
      "airdrop.web3baimao.com",
      "faka.web3baimao.com",
      "bai-mao.gitbook.io",
      "github.com/ChiSonKon",
      "t.me/oxbaimaobot",
      "t.me/baimaotgbot"
    ],
    "refresh_interval_hours": 24,
    "feature_stale_after_days": 7,
    "reference_price_valid_hours": 24,
    "commercial_changes_require_review": true,
    "scrape_failure_policy": "keep_last_success_and_notify_admin",
    "source_priority": [
      "valid_confirmed_order_or_quote",
      "official_checkout_or_approved_catalog",
      "public_reference_snapshot"
