# 示例 systemd 单元。按需修改 User / WorkingDirectory / ExecStart 路径。
[Unit]
Description=Interactive Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/interactive-bot
EnvironmentFile=/opt/interactive-bot/.env
ExecStart=/opt/interactive-bot/venv/bin/python -m interactive-bot
Restart=always
RestartSec=5
# 基本加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/interactive-bot

[Install]
WantedBy=multi-user.target
