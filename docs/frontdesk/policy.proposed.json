      "hard_session_reply_limit": 18,
      "rolling_reply_limit": 24
    },
    "support": {
      "session_reply_limit": 6,
      "rolling_reply_limit": 12
    },
    "partner": {
      "session_reply_limit": 4,
      "rolling_reply_limit": 8
    },
    "all_roles_rolling_reply_limit": 30,
    "all_roles_rolling_model_attempt_limit": 60,
    "request_input_token_limit": 6000,
    "request_output_token_limit": 600,
